<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BAGIAN GAMBAR / NO IMAGE -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#E0E0E0">

            <!-- Kalau nanti pakai Glide, pakai ImageView ini -->
            <ImageView
                android:id="@+id/mobil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Placeholder "No Image" -->
            <TextView
                android:id="@+id/tvNoImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Image"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- KONTEN TEXT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Nama kendaraan -->
            <TextView
                android:id="@+id/tvCarName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Honda Supra X 125"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#212121" />

            <!-- Subjudul: jenis • tahun -->
            <TextView
                android:id="@+id/tvCarMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motor • 2020"
                android:textSize="13sp"
                android:textColor="#757575"
                android:paddingTop="2dp" />

            <!-- BADGE / CHIP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tvPlateNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="# L 2448 GP"
                    android:textSize="12sp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip" />

            </LinearLayout>

            <!-- DESKRIPSI -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobil operasional harian untuk kegiatan dinas."
                android:textSize="12sp"
                android:textColor="#616161"
                android:paddingTop="8dp" />

            <!-- BUTTON PESAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnPesan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesan →"
                    android:textAllCaps="false"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:backgroundTint="#212121"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
