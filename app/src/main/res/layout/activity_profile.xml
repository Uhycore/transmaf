<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Profil -->
    <LinearLayout
        android:orientation="vertical"
        android:background="#2196F3"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <TextView
            android:id="@+id/txtNamaPetugas"
            android:text="Nama Petugas"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtShiftPetugas"
            android:text="Shift Pagi"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/menuHome"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView android:text="Home"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuTravel"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView android:text="Travel"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuHistory"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView android:text="History"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuProfile"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView android:text="Profile"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
