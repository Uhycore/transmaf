<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- ====================== Post 1 ====================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <!-- Header akun -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/aril"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_circle_bg"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="aril mubin"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Foto postingan -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/aril" />

            <!-- Caption -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Hari ini ngoding dulu biar masa depan makin cerah! #codevibes #pranatakomputer"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Waktu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 jam yang lalu"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ====================== Post 2 (duplikat) ====================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/aril"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_circle_bg"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="aril mubin"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/aril" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📸 Dokumentasi CCTV ruang kerja setelah update sistem monitoring."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kemarin"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
