<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/header_bg_green"
            android:paddingTop="80dp"
            android:paddingBottom="100dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Daftar Akun Baru"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Isi data berikut untuk membuat akun TRANSMAF"
                android:textColor="#E8F5E9"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Form -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="4dp"
            android:layout_marginTop="-50dp"
            android:layout_marginHorizontal="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_card_shadow">

            <EditText
                android:id="@+id/etNewUsername"
                android:hint="Nama Pengguna"
                android:inputType="textPersonName"
                android:background="@drawable/input_field"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etNewEmail"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:background="@drawable/input_field"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etNewPassword"
                android:hint="Kata Sandi"
                android:inputType="textPassword"
                android:background="@drawable/input_field"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:hint="Konfirmasi Kata Sandi"
                android:inputType="textPassword"
                android:background="@drawable/input_field"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSave"
                android:text="Daftar Sekarang"
                android:background="@drawable/btn_gradient_green"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:text="Sudah punya akun? Kembali ke Login"
            android:textColor="#00B37A"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
