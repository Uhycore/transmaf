<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F5">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="60dp"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/aril2"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:text="Buat Akun Baru"
                android:textColor="#0F5132"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Daftar dan mulai perjalanan bersama TRANSMAF"
                android:textColor="#6C8575"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- CARD REGISTER -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/glass_card"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etNewUsername"
                android:hint="Nama Pengguna"
                android:padding="14dp"
                android:background="@drawable/input_modern"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etNewEmail"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="14dp"
                android:background="@drawable/input_modern"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etNewPassword"
                android:hint="Kata Sandi"
                android:inputType="textPassword"
                android:padding="14dp"
                android:background="@drawable/input_modern"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:hint="Konfirmasi Kata Sandi"
                android:inputType="textPassword"
                android:padding="14dp"
                android:background="@drawable/input_modern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSave"
                android:text="Daftar Sekarang"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_green_modern"
                android:layout_marginTop="22dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:text="Sudah punya akun? Login di sini"
            android:textColor="#0FAF6D"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>
